# Public Sanity project settings. Use a public dataset for freely accessible content.
NEXT_PUBLIC_SANITY_PROJECT_ID=dt940e6a
NEXT_PUBLIC_SANITY_DATASET=production

# Viewer token for authenticated draft previews. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Your public website origin, e.g. https://your-domain.com (no trailing path).
# Vercel production domains are detected automatically when this is unset.
NEXT_PUBLIC_SITE_URL=
